                                    "type": "pepin_gauche_libre"
                                  }
                                },
                                "DO0": {
                                  "block": {
                                    "type": "pepin_tourner",
                                    "fields": {
                                      "DIR": "gauche"
                                    }
                                  }
                                },
                                "ELSE": {
                                  "block": {
                                    "type": "pepin_tourner",
                                    "fields": {
                                      "DIR": "droite"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
