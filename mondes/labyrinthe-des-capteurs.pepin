    {
      "id": "yeux-sur-les-cotes",
      "type": "jardin",
      "titre": "Des yeux sur les côtés",
      "concept": "les capteurs gauche et droite",
      "consigne": "Nouveaux capteurs : « la voie est libre à gauche / à droite » ! Ma technique : si c'est libre devant, j'avance ; sinon, je tourne du côté libre. Ton programme sera testé sur 3 couloirs différents.",
      "blocs": [
        "avancer",
        "tourner",
        "arroser",
        "tantQue",
        "siSinon",
        "non",
        "devantLibre",
        "gaucheLibre",
        "droiteLibre",
        "surGraine"
      ],
      "carte": [
        ">..####",
        "##.####",
        "##....#",
        "#####.#",
        "#####.o"
      ],
      "autresCartes": [
        [
          "v#####",
          ".#...#",
          ".#.#.#",
          "...#.#",
          "####.#",
          "####o#"
        ],
        [
          "...##",
          ".#.##",
          "^#..o"
