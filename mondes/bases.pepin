    {
      "id": "labyrinthe",
      "type": "jardin",
      "titre": "Le labyrinthe",
      "concept": "la condition « si … sinon »",
      "consigne": "Un vrai labyrinthe ! Ma technique secrète : si la voie est libre, j'avance… sinon, je tourne. Et je recommence tant que je ne suis pas sur la graine !",
      "blocs": [
        "avancer",
        "tourner",
        "arroser",
        "tantQue",
        "siSinon",
        "non",
        "devantLibre",
        "surGraine"
      ],
