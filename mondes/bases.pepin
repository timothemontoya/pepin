                          }
                        }
                      }
                    },
                    "DO": {
                      "block": {
                        "type": "controls_if",
                        "extraState": {
                          "hasElse": true
                        },
                        "inputs": {
                          "IF0": {
                            "block": {
                              "type": "pepin_devant_libre"
                            }
                          },
                          "DO0": {
                            "block": {
                              "type": "pepin_avancer"
                            }
                          },
                          "ELSE": {
                            "block": {
                              "type": "pepin_tourner",
                              "fields": {
                                "DIR": "droite"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "next": {
                    "block": {
                      "type": "pepin_arroser"
                    }
                  }
                }
              },
              "x": 40,
              "y": 40
            }
          ]
        }
      }
